# Recomendado en devcontainer/Podman: dejar vacio para usar proxy interno de Vite en /api
VITE_API_BASE=

# Destino real del backend para el proxy de Vite (solo desarrollo)
# Podman/Docker Desktop (host): http://host.containers.internal:8080
VITE_API_PROXY_TARGET=http://host.containers.internal:8080

VITE_ADMIN_ROLE=admin
VITE_ACTOR=admin-ui

# Login con Amazon Cognito (Hosted UI, Authorization Code + PKCE).
# En produccion se inyectan en runtime con COGNITO_DOMAIN / COGNITO_CLIENT_ID (ConfigMap).
# Sin ellos, `npm run dev` ofrece un acceso local sin autenticacion real.
# Dominio sin https://, p. ej. mi-app.auth.us-east-1.amazoncognito.com
VITE_COGNITO_DOMAIN=
VITE_COGNITO_CLIENT_ID=
# Callback y logout registrados en el App Client (por defecto: <origen>/auth/callback y <origen>/login)
VITE_COGNITO_REDIRECT_URI=
VITE_COGNITO_LOGOUT_URI=
