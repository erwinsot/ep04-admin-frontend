# Recomendado en devcontainer/Podman: dejar vacio para usar proxy interno de Vite en /api
VITE_API_BASE=

# Destino real del backend para el proxy de Vite (solo desarrollo)
# Podman/Docker Desktop (host): http://host.containers.internal:8080
VITE_API_PROXY_TARGET=http://host.containers.internal:8080

VITE_ADMIN_ROLE=admin
VITE_ACTOR=admin-ui
