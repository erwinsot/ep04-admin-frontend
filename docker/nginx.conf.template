server {
  listen 80;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  location /api/ {
    proxy_pass ${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }

  location = /config.js {
    default_type application/javascript;
    add_header Cache-Control "no-store";
    return 200 'window.__EP04_CONFIG__={"cognitoDomain":"${COGNITO_DOMAIN}","cognitoClientId":"${COGNITO_CLIENT_ID}","cognitoRedirectUri":"${COGNITO_REDIRECT_URI}","cognitoLogoutUri":"${COGNITO_LOGOUT_URI}","cognitoScopes":"${COGNITO_SCOPES}","localLogin":"${LOCAL_LOGIN}"};';
  }

  location = /healthz {
    access_log off;
    add_header Content-Type text/plain;
    return 200 "ok";
  }
}
